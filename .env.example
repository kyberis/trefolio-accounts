# Local-only development settings for trefolio-accounts-dev.
# Copy to .env.local and adjust as needed.

# ----- Database (production: required on Vercel) -----
# Empty or non-postgres URL → local dev uses idp-dev.db (SQLite).
# Use a single read-write Postgres URL. Read-replica or split read pools can
# cause OAuth `invalid_grant` (auth code INSERT on primary, token route SELECT on lagging replica).
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

NEXT_PUBLIC_APP_URL=http://localhost:3300
IDP_RS256_KID=trefolio-idp-dev-2026

# RS256 keys for signing ID tokens (JWKS uses the public half).
# Local dev: generate idp-private.pem + idp-public.pem in the repo root (see README).
# Vercel/serverless: paste full PEM bodies here (multiline) — files are not deployed.
# IDP_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# IDP_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Shared with product apps for /v1/* service-to-service requests.
# Same secret is used by the IdP admin UI to fan out to each product's
# /api/v1/users/by-sub endpoint when rendering "linked apps" badges.
# Production: one strong random value; paste the SAME string into Clara and Will as IDP_SERVICE_TOKEN.
IDP_SERVICE_TOKEN=dev-service-token-do-not-use-in-prod-32chars

# Per-client OAuth secrets (production: use `openssl rand -base64 32` each — not the dev defaults).
# Must match each product app's server env:
#   IDP_CLIENT_SECRET_CLARA = Clara's IDP_CLIENT_SECRET
#   IDP_CLIENT_SECRET_WILL  = Will's IDP_CLIENT_SECRET
#   IDP_CLIENT_SECRET_TREFOLIO = trefolio Warren OIDC client secret
IDP_CLIENT_SECRET_TREFOLIO=dev-trefolio-secret
IDP_CLIENT_SECRET_CLARA=dev-clara-secret
IDP_CLIENT_SECRET_WILL=dev-will-secret
# Claude Connectors Directory OAuth client (`claude-mcp`). Share with mcp-review@anthropic.com for oauth_anthropic_creds.
IDP_CLIENT_SECRET_CLAUDE_MCP=dev-claude-mcp-secret

# Comma-separated allow-list of admin emails. Any signed-in IdP user whose
# email is in this list can access /admin/users. Demoting an admin means
# removing them from this list (no DB-level admin flag, by design).
# Leave empty to disable the admin UI entirely (it renders a setup splash).
IDP_ADMIN_EMAILS=admin@trefolio.test

# Optional overrides for product base URLs the IdP calls when probing
# linked accounts. Leave unset and we pick localhost in dev / production
# hosts in prod.
# TREFOLIO_BASE_URL=http://localhost:3010
# Server-to-server origin when trefolio.com is Cloudflare-proxied (Bot Fight).
# TREFOLIO_SERVER_ORIGIN=https://trefolio-marcos-projects-0d7207fa.vercel.app
# CLARA_BASE_URL=http://localhost:3001
# WILL_BASE_URL=http://localhost:3200
# Optional S2S overrides. Prefer custom domains for Clara/Will — their
# *.vercel.app aliases have Deployment Protection (SSO). Do not set these
# to vercel.app hosts unless CLARA_VERCEL_PROTECTION_BYPASS / WILL_… is set.
# CLARA_SERVER_ORIGIN=
# WILL_SERVER_ORIGIN=

# Optional: Vercel "Protection Bypass for Automation" secret per product (same
# value as in each Vercel project's Deployment Protection settings). Required
# for admin "linked apps" probes when production uses Deployment Protection —
# otherwise server-side fetch gets HTTP 403 before Next.js runs.
# TREFOLIO_VERCEL_PROTECTION_BYPASS=
# CLARA_VERCEL_PROTECTION_BYPASS=
# WILL_VERCEL_PROTECTION_BYPASS=

# HMAC secret for the IdP single-sign-on session cookie. Falls back to a
# deterministic dev value when unset; set in production.
# IDP_SESSION_SECRET=

# Optional: separate HS256 secret for email-verification links (defaults to
# IDP_SESSION_SECRET / IDP_CLIENT_SECRET_TREFOLIO).
# IDP_EMAIL_VERIFICATION_SECRET=

# Password signup — verification email via Resend (same API key / from as trefolio).
# Required in production unless IDP_SKIP_VERIFICATION_EMAIL=true.
# New-user operator notification (production only): same pattern as Warren
# `sendAdminNewCustomerNotification`. Defaults to info@trefolio.com if unset.
# SIGNUP_NOTIFY_EMAIL=
# RESEND_API_KEY=
# RESEND_FROM_ADDRESS=trefolio <noreply@trefolio.com>
# Public origin for logo assets in the HTML template (default: https://trefolio.com).
# TREFOLIO_EMAIL_ASSETS_ORIGIN=https://trefolio.com

# Production only: suppress verification emails (e.g. staging). Dev never sends
# verification mail (`NODE_ENV !== 'production'` skips automatically).
# IDP_SKIP_VERIFICATION_EMAIL=true

# ----- Business ops Telegram (unified ProdOps bot) -----
# Linking and delivery go through trefolio → trefolio-prodops (@trefoliobot).
# Do not setWebhook on this IdP. Generate links from /agents or trefolio /admin/settings.
# TELEGRAM_OPS_BOT_TOKEN=   # retired; outbound is ProdOps
# TELEGRAM_OPS_WEBHOOK_SECRET=  # retired
# TELEGRAM_OPS_BOT_USERNAME=trefoliobot  # unused; username lives in trefolio ProdOps config

# Vercel Cron auth for /api/cron/ops-digest (optional locally).
# CRON_SECRET=

# ----- Stripe billing (same account & Price IDs as Warren / stocktracker) -----
# Copy the STRIPE_* values from your stocktracker `.env.local` (or Vercel).
# Webhook: create an endpoint for THIS deployment's `/api/billing/webhook` and
# set STRIPE_WEBHOOK_SECRET to that endpoint's signing secret (can differ from Warren).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=
# Optional — device promo parity with Warren:
# STRIPE_COUPON_DEVICE_FREE_YEAR=

# Google OAuth credentials. When set, the "Continue with Google" button
# appears on /oauth2/authorize. The redirect URI you must whitelist at
# Google is `${IDP_ISSUER}/api/auth/google/callback` — e.g.
# `https://user.trefolio.com/api/auth/google/callback` in production and
# `http://localhost:3300/api/auth/google/callback` (or your local proxy
# host) in dev. Leave empty to hide the Google button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
