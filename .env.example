# Local-only development settings for trefolio-accounts-dev.
# Copy to .env.local and adjust as needed.

NEXT_PUBLIC_APP_URL=http://localhost:3300
IDP_RS256_KID=trefolio-idp-dev-2026

# Shared with product apps for /v1/* service-to-service requests.
IDP_SERVICE_TOKEN=dev-service-token-do-not-use-in-prod-32chars

# Per-client OAuth secrets.
IDP_CLIENT_SECRET_TREFOLIO=dev-trefolio-secret
IDP_CLIENT_SECRET_CLARA=dev-clara-secret
IDP_CLIENT_SECRET_WILL=dev-will-secret
